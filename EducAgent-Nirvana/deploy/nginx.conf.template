worker_processes 1;
pid "__RUNTIME__/nginx.pid";
error_log stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_body_temp_path "__RUNTIME__/client_temp";
    proxy_temp_path "__RUNTIME__/proxy_temp";
    fastcgi_temp_path "__RUNTIME__/fastcgi_temp";
    uwsgi_temp_path "__RUNTIME__/uwsgi_temp";
    scgi_temp_path "__RUNTIME__/scgi_temp";
    client_max_body_size 32k;
    client_body_timeout 15s;
    send_timeout 180s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    server {
        listen __BIND__:9090;
        root "__SITE__";
        index index.html;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Cache-Control no-store always;

        location = /healthz { default_type text/plain; return 200 "gateway ready\n"; }
        location = /portal { return 301 /portal/; }
        location = /nirvana { return 301 /nirvana/; }
        location = /authoring { return 404; }
        location ^~ /authoring/ { return 404; }
        location = /api/validate-content-pack { return 404; }
        location = /api/preview { return 404; }
        location ^~ /api/preview/ { return 404; }
        location /api/ {
            client_max_body_size 8k;
            proxy_pass http://127.0.0.1:9091;
        }
        # The trailing slash replaces /nirvana/api/ with /api/ upstream.
        location ^~ /nirvana/api/ { proxy_pass http://127.0.0.1:9092/api/; }
        location ~ /\. { return 404; }
        location ~* \.(env|json|jsonl|md|pdf|py|toml|map|log|zip|gz|bak)$ { return 404; }
        location / { try_files $uri $uri/ =404; }
    }
}
