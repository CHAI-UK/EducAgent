  "sources": [],
  "claims": [
    {
      "claim_id": "larger-denominator-smaller-unit-fraction",
      "proposition": "For positive unit fractions, a larger denominator represents a smaller fraction.",
      "deterministic_derivation": {"method_id": "fractions.unit-fraction-order", "method_version": "1.0.0"},
      "release_status": "released"
    }
  ],
  "resources": [
    {"resource_id": "fraction.practice.question", "kind": "question", "text": "Which fraction is larger: 1/3 or 1/5?", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.practice.hint", "kind": "hint", "text": "Imagine dividing the same whole into three equal pieces and then into five equal pieces.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.practice.explanation", "kind": "explanation", "text": "When one whole is split into more equal pieces, each unit fraction is smaller. So 1/3 is larger than 1/5.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.practice.accepted", "kind": "consequence", "text": "Correct. Thirds are larger pieces than fifths of the same whole.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.practice.rejected", "kind": "consequence", "text": "The denominator counts equal pieces in the same whole. More pieces means each piece is smaller.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.transfer.question", "kind": "question", "text": "At a different bakery, which is larger: 1/8 of a cake or 1/10 of the same cake?", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.transfer.hint", "kind": "hint", "text": "Compare how many equal pieces the same cake is divided into.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.transfer.explanation", "kind": "explanation", "text": "Eighths are larger than tenths of the same cake, so 1/8 is larger than 1/10.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.transfer.accepted", "kind": "consequence", "text": "Correct. Dividing the same cake into eight pieces gives a larger piece than dividing it into ten.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"},
    {"resource_id": "fraction.transfer.rejected", "kind": "consequence", "text": "A larger denominator means more equal pieces, so each unit fraction is smaller.", "claim_ids": ["larger-denominator-smaller-unit-fraction"], "release_status": "released"}
  ],
