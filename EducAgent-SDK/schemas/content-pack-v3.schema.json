{
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "description": "One deterministic activity with a declared structured response type.",
      "properties": {
        "activity_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Activity Id",
          "type": "string"
        },
        "activity_type": {
          "default": "choice",
          "enum": [
            "choice",
            "classification",
            "causal_scene"
          ],
          "title": "Activity Type",
          "type": "string"
        },
        "causal_scene_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causal Scene Id"
        },
        "choices": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "title": "Choices",
          "type": "array"
        },
        "concept_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Concept Id",
          "type": "string"
        },
        "covered_concept_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Covered Concept Ids",
          "type": "array"
        },
        "experiment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExperimentWorkbench"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanation_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Explanation Resource Id",
          "type": "string"
        },
        "is_transfer": {
          "default": false,
          "title": "Is Transfer",
          "type": "boolean"
        },
        "question_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Question Resource Id",
          "type": "string"
        },
        "requires_revision": {
          "default": false,
          "title": "Requires Revision",
          "type": "boolean"
        },
        "scenario_image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workbench": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonWorkbench"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "activity_id",
        "concept_id",
        "question_resource_id",
        "explanation_resource_id"
      ],
      "title": "Activity",
      "type": "object"
    },
    "CausalScene": {
      "additionalProperties": false,
      "description": "Released, authored data for one deterministic M0 causal investigation.",
      "properties": {
        "assessment": {
          "$ref": "#/$defs/CausalSceneAssessment"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "direct_explanation_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Direct Explanation Resource Id",
          "type": "string"
        },
        "hook_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Hook Resource Id",
          "type": "string"
        },
        "intervention": {
          "$ref": "#/$defs/CausalSceneIntervention"
        },
        "intervention_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Intervention Resource Id",
          "type": "string"
        },
        "model_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Model Resource Id",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/CausalSceneNode"
          },
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        },
        "observed_records": {
          "items": {
            "$ref": "#/$defs/CausalSceneRecord"
          },
          "minItems": 1,
          "title": "Observed Records",
          "type": "array"
        },
        "permitted_edges": {
          "items": {
            "$ref": "#/$defs/CausalSceneEdge"
          },
          "minItems": 1,
          "title": "Permitted Edges",
          "type": "array"
        },
        "prediction_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Prediction Resource Id",
          "type": "string"
        },
        "predictions": {
          "items": {
            "$ref": "#/$defs/CausalScenePrediction"
          },
          "minItems": 2,
          "title": "Predictions",
          "type": "array"
        },
        "records_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Records Resource Id",
          "type": "string"
        },
        "reflection_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Reflection Resource Id",
          "type": "string"
        },
        "result_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Result Resource Id",
          "type": "string"
        },
        "scene_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Scene Id",
          "type": "string"
        },
        "simulation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CausalSceneSimulation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "title",
        "claim_ids",
        "hook_resource_id",
        "records_resource_id",
        "model_resource_id",
        "prediction_resource_id",
        "intervention_resource_id",
        "result_resource_id",
        "reflection_resource_id",
        "direct_explanation_resource_id",
        "nodes",
        "permitted_edges",
        "observed_records",
        "intervention",
        "predictions",
        "assessment"
      ],
      "title": "CausalScene",
      "type": "object"
    },
    "CausalSceneAssessment": {
      "additionalProperties": false,
      "description": "The hidden, deterministic rubric for a scene's final submitted model.",
      "properties": {
        "accepted_consequence_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Accepted Consequence Resource Id",
          "type": "string"
        },
        "accepted_edges": {
          "items": {
            "$ref": "#/$defs/CausalSceneEdge"
          },
          "minItems": 1,
          "title": "Accepted Edges",
          "type": "array"
        },
        "hint_resource_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Hint Resource Ids",
          "type": "array"
        },
        "rejected_consequence_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Rejected Consequence Resource Id",
          "type": "string"
        },
        "rejected_misconception_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Rejected Misconception Id",
          "type": "string"
        }
      },
      "required": [
        "accepted_edges",
        "hint_resource_ids",
        "accepted_consequence_resource_id",
        "rejected_consequence_resource_id",
        "rejected_misconception_id"
      ],
      "title": "CausalSceneAssessment",
      "type": "object"
    },
    "CausalSceneEdge": {
      "additionalProperties": false,
      "description": "One permitted proposed arrow in the first causal workbench.",
      "properties": {
        "child_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Child Id",
          "type": "string"
        },
        "parent_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Parent Id",
          "type": "string"
        }
      },
      "required": [
        "parent_id",
        "child_id"
      ],
      "title": "CausalSceneEdge",
      "type": "object"
    },
    "CausalSceneIntervention": {
      "additionalProperties": false,
      "description": "The one declared assignment and its deterministic aggregate result.",
      "properties": {
        "action_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Action Id",
          "type": "string"
        },
        "result_records": {
          "items": {
            "$ref": "#/$defs/CausalSceneRecord"
          },
          "minItems": 1,
          "title": "Result Records",
          "type": "array"
        },
        "value": {
          "enum": [
            "yes",
            "no"
          ],
          "title": "Value",
          "type": "string"
        },
        "variable_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Variable Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "variable_id",
        "value",
        "result_records"
      ],
      "title": "CausalSceneIntervention",
      "type": "object"
    },
    "CausalSceneNode": {
      "additionalProperties": false,
      "description": "One variable made available to the learner's small DAG editor.",
      "properties": {
        "initially_visible": {
          "title": "Initially Visible",
          "type": "boolean"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "label",
        "initially_visible"
      ],
      "title": "CausalSceneNode",
      "type": "object"
    },
    "CausalScenePrediction": {
      "additionalProperties": false,
      "description": "One content-authored prediction a learner may commit before a reveal.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "prediction_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Prediction Id",
          "type": "string"
        }
      },
      "required": [
        "prediction_id",
        "label"
      ],
      "title": "CausalScenePrediction",
      "type": "object"
    },
    "CausalSceneRecord": {
      "additionalProperties": false,
      "description": "One aggregate row in the M0 observational or intervention table.",
      "properties": {
        "arrivals": {
          "minimum": 0,
          "title": "Arrivals",
          "type": "integer"
        },
        "pavement_wet": {
          "enum": [
            "yes",
            "no"
          ],
          "title": "Pavement Wet",
          "type": "string"
        },
        "umbrella_carried": {
          "enum": [
            "yes",
            "no"
          ],
          "title": "Umbrella Carried",
          "type": "string"
        }
      },
      "required": [
        "umbrella_carried",
        "pavement_wet",
        "arrivals"
      ],
      "title": "CausalSceneRecord",
      "type": "object"
    },
    "CausalSceneSimulation": {
      "additionalProperties": false,
      "description": "Versioned finite SCMs, not equations inferred from a learner's arrows.",
      "properties": {
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/SceneHypothesis"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Hypotheses",
          "type": "array"
        },
        "kind": {
          "const": "umbrella_scm",
          "default": "umbrella_scm",
          "title": "Kind",
          "type": "string"
        },
        "minimum_hypotheses": {
          "default": 2,
          "maximum": 3,
          "minimum": 2,
          "title": "Minimum Hypotheses",
          "type": "integer"
        },
        "model_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Model Version",
          "type": "string"
        },
        "population_size": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Population Size",
          "type": "integer"
        },
        "reference_hypothesis_id": {
          "enum": [
            "rain-common-cause",
            "umbrella-causes-wet",
            "wet-causes-umbrella"
          ],
          "title": "Reference Hypothesis Id",
          "type": "string"
        },
        "root_yes_count": {
          "minimum": 0,
          "title": "Root Yes Count",
          "type": "integer"
        }
      },
      "required": [
        "population_size",
        "root_yes_count",
        "hypotheses",
        "reference_hypothesis_id"
      ],
      "title": "CausalSceneSimulation",
      "type": "object"
    },
    "Choice": {
      "additionalProperties": false,
      "description": "One stable answer option and its resource references.",
      "properties": {
        "consequence_resource_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Consequence Resource Id",
          "type": "string"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "hint_resource_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Hint Resource Ids",
          "type": "array"
        },
        "misconception_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Misconception Id"
        },
        "option_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Option Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "text",
        "correct",
        "consequence_resource_id"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One canonical proposition with exactly one provenance route.",
      "properties": {
        "claim_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Claim Id",
          "type": "string"
        },
        "deterministic_derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeterministicDerivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposition": {
          "minLength": 1,
          "title": "Proposition",
          "type": "string"
        },
        "release_status": {
          "enum": [
            "draft",
            "released"
          ],
          "title": "Release Status",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "proposition",
        "release_status"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ComparisonTable": {
      "additionalProperties": false,
      "description": "One currently visible authored comparison, never a hidden result table.",
      "properties": {
        "columns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "rows": {
          "items": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "table_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Table Id",
          "type": "string"
        }
      },
      "required": [
        "table_id",
        "label",
        "columns",
        "rows"
      ],
      "title": "ComparisonTable",
      "type": "object"
    },
    "ComparisonWorkbench": {
      "additionalProperties": false,
      "description": "Released current-activity observations shared by the renderer and Tutor.",
      "properties": {
        "introduction": {
          "minLength": 1,
          "title": "Introduction",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "scenario_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "investigate",
            "capstone"
          ],
          "title": "Stage",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/ComparisonTable"
          },
          "minItems": 1,
          "title": "Tables",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "introduction",
        "scenario_id",
        "stage",
        "tables"
      ],
      "title": "ComparisonWorkbench",
      "type": "object"
    },
    "Concept": {
      "additionalProperties": false,
      "description": "One content-owned objective and its completion evidence requirements.",
      "properties": {
        "completion_activity_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Completion Activity Ids",
          "type": "array"
        },
        "concept_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Concept Id",
          "type": "string"
        },
        "m1_ready_activity_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "M1 Ready Activity Ids",
          "type": "array"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "objective",
        "completion_activity_ids"
      ],
      "title": "Concept",
      "type": "object"
    },
    "DeterministicDerivation": {
      "additionalProperties": false,
      "description": "Declared versioned method identifier for a deterministic claim.",
      "properties": {
        "method_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Method Id",
          "type": "string"
        },
        "method_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Method Version",
          "type": "string"
        }
      },
      "required": [
        "method_id",
        "method_version"
      ],
      "title": "DeterministicDerivation",
      "type": "object"
    },
    "EffectExperimentConfig": {
      "additionalProperties": false,
      "description": "Learner settings for the two-stratum intervention teaching model.",
      "properties": {
        "analysis": {
          "default": "pooled",
          "enum": [
            "pooled",
            "standardized"
          ],
          "title": "Analysis",
          "type": "string"
        },
        "assignment": {
          "default": "self_selected",
          "enum": [
            "self_selected",
            "randomized"
          ],
          "title": "Assignment",
          "type": "string"
        },
        "kind": {
          "const": "effect",
          "default": "effect",
          "title": "Kind",
          "type": "string"
        },
        "target_high_pct": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "multipleOf": 10,
          "title": "Target High Pct",
          "type": "integer"
        }
      },
      "title": "EffectExperimentConfig",
      "type": "object"
    },
    "EffectExperimentModel": {
      "additionalProperties": false,
      "description": "Frozen authored rates and labels; never sent as Tutor or browser state.",
      "properties": {
        "a_high": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "A High",
          "type": "number"
        },
        "a_low": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "A Low",
          "type": "number"
        },
        "b_high": {
          "default": 0.4,
          "maximum": 1,
          "minimum": 0,
          "title": "B High",
          "type": "number"
        },
        "b_low": {
